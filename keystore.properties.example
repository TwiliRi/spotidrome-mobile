# Скопируй этот файл в keystore.properties и заполни своими данными
# keystore.properties НЕ коммитится в git (уже в .gitignore если есть)
# Пример:
storeFile=/home/user/release.keystore
# или относительный путь: app/release.keystore или ../mykey.jks
storePassword=твой_пароль_от_keystore
keyAlias=твой_alias
keyPassword=твой_пароль_от_ключа

# Для Spotidrome по умолчанию можно использовать:
# storeFile=release.keystore
# storePassword=sonicspot123
# keyAlias=sonicspot
# keyPassword=sonicspot123
