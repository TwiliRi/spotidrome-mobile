<?xml version="1.0" encoding="utf-8"?>
<!--
  Переопределение drawable-ресурсов androidx.media3 (официальный механизм из
  DefaultMediaNotificationProvider javadoc: «override the drawable resource ID with
  a drawable element in res/values»). Так иконки play/pause/prev/next в шторке
  уведомлений и медиа-карточке Android 13+ становятся нашими, а не дефолтными.
-->
<resources>
    <item name="media3_icon_play" type="drawable">@drawable/ic_notif_play</item>
    <item name="media3_icon_pause" type="drawable">@drawable/ic_notif_pause</item>
    <item name="media3_icon_previous" type="drawable">@drawable/ic_notif_prev</item>
    <item name="media3_icon_next" type="drawable">@drawable/ic_notif_next</item>
</resources>
