# ==================== Spotidrom .gitattributes ====================
# Авто-определение окончаний строк

# Текстовые файлы - нормализуем в LF при коммите
* text=auto eol=lf

# Явно текстовые
*.kts text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.pro text eol=lf
*.txt text eol=lf

# Бинарные - не трогаем
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jks binary
*.keystore binary
*.so binary
*.a binary
*.jar binary
*.apk binary
*.aab binary
*.ttf binary
*.otf binary
*.mp3 binary
*.ogg binary
*.wav binary

# Gradle wrapper - должен быть LF и executable
gradlew text eol=lf
gradlew.bat text eol=crlf
gradle/wrapper/gradle-wrapper.jar binary
gradle/wrapper/gradle-wrapper.properties text eol=lf

# Linguist - считаем сгенерированные файлы не кодом
gradle/wrapper/gradle-wrapper.properties linguist-generated=false
*.pbxproj linguist-generated=false
